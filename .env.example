# Clash of Clans API token.
# Create a free token at https://developer.clashofclans.com/ and bind it to
# your server's public IP. The token is IP-restricted, so keep it server-side.
COC_API_TOKEN=

# Your clan's tag, including the leading '#', e.g. #2PP0JCCL
# The dashboard loads this clan by default.
COC_CLAN_TAG=

# --- Recruitment requirements (used to score prospective members) ---
# Minimum Town Hall level a recruit should have.
RECRUIT_MIN_TOWNHALL=12
# Minimum trophies.
RECRUIT_MIN_TROPHIES=2000
# Minimum total war stars earned.
RECRUIT_MIN_WAR_STARS=200
# Minimum donation ratio (given / received) expected from an active player.
RECRUIT_MIN_DONATION_RATIO=0.5
# Require the player's war preference to be "in" (opted into wars).
RECRUIT_REQUIRE_WAR_OPT_IN=true

# --- Member management thresholds ---
# Members who donate fewer than this over a season may be flagged inactive.
INACTIVE_DONATION_FLOOR=100
